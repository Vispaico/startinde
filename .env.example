# StartinDE environment — copy to .env and adjust
# Database
DATABASE_URL=postgres://startinde:startinde@localhost:5432/startinde

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Qdrant (vector search)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=startinde

# LiteLLM (self-hosted model gateway)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# SearXNG (discovery)
SEARXNG_URL=https://search.vispaico.com

# Firecrawl Simple (scraping)
FIRECRAWL_URL=http://localhost:3002

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:4200
API_URL=http://localhost:3000
ADMIN_URL=http://localhost:4202
